# Set these in Netlify -> Site configuration -> Environment variables
# (or copy to .env for local `netlify dev`). Never commit real values.

# Resend API key (same one your other tools use).
RESEND_API_KEY=
# MUST be on the verified havenbuiltmedia.com domain, never onboarding@resend.dev
# (that's the sandbox sender that only delivers to the account owner).
# Bare address or "Name <address>" both work.
NOTIFY_FROM=noreply@havenbuiltmedia.com
# Where submission emails go.
NOTIFY_TO=jessi@thiswaytofabulous.com

# Any long random string. The dashboard sends it to read submissions.
# Put the same value in the dashboard site's SHOOT_GUIDES_CODE.
ADMIN_CODE=
